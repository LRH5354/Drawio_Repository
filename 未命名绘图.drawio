        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n---\nflowchart TD\n  subgraph SRC[\&quot;触发源\&quot;]\n    E1[\&quot;业务事件：计划填报 / 进度填报 / 委托验收 / 院检 / 成果处置 / 提醒规则 / 导出\&quot;]\n    E2[\&quot;人工发起任务（发起对话框 · password 类禁手动）\&quot;]\n    E3[\&quot;后端规则引擎（按工作日历判定）\&quot;]\n  end\n\n  subgraph TASK[\&quot;任务中心 /daily（唯一可人工发起）\&quot;]\n    T0[\&quot;创建任务 source=manual/auto\&quot;]\n    T1[\&quot;pending 待办理\&quot;]\n    T2[\&quot;processing 办理中\&quot;]\n    T3[\&quot;done 已办理 · 销号\&quot;]\n    T4[\&quot;canceled 已撤回（终态）\&quot;]\n  end\n\n  subgraph TODO[\&quot;待办箱 /todos · 通知即待办（十类来源）\&quot;]\n    B0[\&quot;undone 未办\&quot;]\n    B1[\&quot;分桶：已逾期 ＞ 临期(≤3工作日) ＞ 未办\&quot;]\n    B2[\&quot;done 已办 · 标记办理登记结果(仅本人)\&quot;]\n    B3[\&quot;auto_closed 自动关闭(带 closedReason)\&quot;]\n  end\n\n  subgraph RISK[\&quot;风险提醒 /risks · 只提示不办理（七类类型）\&quot;]\n    R0[\&quot;open 未解除 · 红=逾期 / 黄=临期\&quot;]\n    R1[\&quot;auto_closed 自动解除（记 autoClosedAt）\&quot;]\n    R2[\&quot;manual_closed 人工关闭（原因必填留痕）\&quot;]\n  end\n\n  E2 --&gt; T0\n  T0 --&gt; T1\n  T0 --&gt;|\&quot;生成 daily_task 待办\&quot;| B0\n  T1 --&gt;|\&quot;办理登记 handle（可多次续办留痕）\&quot;| T2\n  T2 --&gt;|\&quot;完成销号 complete\&quot;| T3\n  T1 --&gt;|\&quot;撤回 withdraw（仅手动+pending）\&quot;| T4\n  T3 --&gt;|\&quot;后端关闭关联待办\&quot;| B3\n  T4 --&gt;|\&quot;后端关闭关联待办\&quot;| B3\n  T3 --&gt;|\&quot;task_overdue 风险解除\&quot;| R1\n\n  E1 --&gt;|\&quot;生成对应来源待办 plan_fill / progress_fill / entrusted_acceptance / inspection_confirm 等\&quot;| B0\n  B0 --&gt; B1\n  B1 --&gt;|\&quot;标记办理 doneTodo\&quot;| B2\n  B1 --&gt;|\&quot;去办理 · 跳 route_uri 源业务页\&quot;| E1\n\n  T1 --&gt;|\&quot;临期 / 逾期未完成\&quot;| E3\n  E3 --&gt;|\&quot;识别生成 open 风险（同源同类型唯一 · 幂等）\&quot;| R0\n  R0 --&gt;|\&quot;推送 risk_receiver 接收矩阵（负责人/部门/计划/质检/院领导/管理员 · 已读回执）\&quot;| R1\n  R0 --&gt;|\&quot;同时生成 risk_handle 待办 route_uri=/risks?focus=id\&quot;| B0\n  R0 --&gt;|\&quot;进入处置 · 跳 /projects 源业务\&quot;| E1\n  R0 --&gt;|\&quot;人工关闭 closeRisk\&qu